# Copy to .env. Fill values from YOUR cloud account. Never paste secrets into chat.
# Use the model inference base URL below, not the /api/projects/ project URL.
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_REGION=YOUR-RESOURCE-REGION
# Leave blank for Microsoft Entra ID after az login and the required role assignment.
# Alternatively, paste your own resource key here for this local lab.
AZURE_OPENAI_API_KEY=

GOOGLE_CLOUD_PROJECT=YOUR-GOOGLE-CLOUD-PROJECT-ID
# global is convenient for synthetic lab data; select an approved location for real data.
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=YOUR-AVAILABLE-GEMINI-MODEL-ID
